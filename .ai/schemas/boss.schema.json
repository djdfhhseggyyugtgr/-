{
  "title": "Boss move sheet",
  "description": "Stats and attack timings for one boss. Animation, AI and datapack timings must match it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["boss", "name", "status", "timing_unit", "hp", "poise", "moves"],
  "properties": {
    "boss": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved"] },
    "timing_unit": { "const": "tick", "description": "1 tick = 1/20 s" },
    "hp": { "type": "number", "exclusiveMinimum": 0 },
    "poise": { "type": "number", "minimum": 0 },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "telegraph_frames", "active_frames", "recovery_frames", "damage", "poise_damage", "punish_window"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "telegraph_frames": { "type": "integer", "minimum": 0 },
          "active_frames": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
          "recovery_frames": { "type": "integer", "minimum": 0 },
          "damage": { "type": "number", "minimum": 0 },
          "poise_damage": { "type": "number", "minimum": 0 },
          "punish_window": { "type": "boolean" },
          "animation": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "note": { "type": "string" }
  }
}
